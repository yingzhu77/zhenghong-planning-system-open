# Run node scripts/setup-env.mjs to generate .env with random credentials.
COMPOSE_PROJECT_NAME=planning-system
APP_IMAGE=planning-system-api:local
POSTGRES_DB=planning
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SESSION_SECRET=
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
APP_ORIGIN=http://localhost:8080
# Optional comma-separated additional HTTP(S) origins; no paths or wildcards.
APP_ADDITIONAL_ORIGINS=
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_IDLE_HOURS=12
UPLOADS_VOLUME=planning-system_uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional server-only AI config JSON; leave empty to disable AI. Never store the key here.
PLANNING_DEEPSEEK_CONFIG=
